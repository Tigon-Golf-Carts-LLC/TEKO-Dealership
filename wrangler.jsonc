{
  // Static-assets-only Worker: no server code, Cloudflare serves the teko-ev
  // Vite build output directly.
  //
  // Every real route ships its own prerendered HTML, so `not_found_handling`
  // can return a genuine 404 for unknown paths rather than a 200 that only
  // looks like an error once JavaScript has run.
  //
  // This lives at the repo root on purpose: Workers Builds runs `wrangler deploy`
  // here, and without a config at the working directory Wrangler refuses to pick
  // a project out of the 9-package workspace.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "teko-dealership",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./artifacts/teko-ev/dist/public",
    "not_found_handling": "404-page"
  }
}
